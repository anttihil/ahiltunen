---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title = "Antti Hiltunen,  | Software Engineer — Platforms, AI Systems & Robotics UI",
  description = "Personal site, engineering portfolio, and technical articles by Antti Hiltunen. Software Engineer at UCLA building internal platforms, AI systems, and intuitive interfaces.",
  image = "/icon.png",
  type = "website",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Antti Hiltunen, " />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.site)} />

    <!-- JSON-LD Structured Data for Person -->
    <script type="application/ld+json" is:raw>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Antti Hiltunen",
        "jobTitle": "Software Engineer",
        "worksFor": {
          "@type": "Organization",
          "name": "UCLA"
        },
        "alumniOf": ["UCLA", "University of Turku"],
        "hasCredential": " in Philosophy",
        "email": "anttihil@gmail.com",
        "url": "https://ahiltunen.com",
        "sameAs": [
          "https://www.linkedin.com/in/hiltunen-antti",
          "https://github.com/anttihil"
        ]
      }
    </script>
  </head>
  <body>
    <Header />
    <main class="main-content container">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .main-content {
    flex: 1;
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
    padding: 2.5rem 1.25rem;
  }
</style>
