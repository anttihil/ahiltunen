---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const about = await getEntry('about', 'about');
if (!about) throw new Error('Missing About content: src/content/about/about.md');
const { Content } = await render(about);
---

<BaseLayout
  title={`${about.data.title} | Antti Hiltunen`}
  description={about.data.description}
>
  <div class="about-container">
    <header class="about-header">
      <h1 class="about-title">{about.data.title}</h1>
      <p class="about-lead">{about.data.lead}</p>
    </header>

    <div class="about-content">
      <Content />
      <div class="contact-links">
        {about.data.contactLinks.map((link) => (
          <a
            href={link.url}
            class="inline-link"
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
          >{link.label}</a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .about-container {
    display: flex;
    flex-direction: column;
    padding-bottom: 5rem;
  }

  .about-header {
    padding: 4.5rem 0 3rem;
  }

  .about-title {
    margin-bottom: 1rem;
    font-size: clamp(2.55rem, 5vw, 3.4rem);
  }

  .about-lead {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0;
  }

  .about-content {
    padding: 0;
    max-width: 740px;
  }

  .about-content :global(h2) {
    margin-top: 2.5rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--border-color);
    color: var(--text-heading);
    margin-bottom: 1.35rem;
    font-size: 1.45rem;
    font-weight: 400;
  }

  .about-content :global(h2:first-child) {
    margin-top: 0;
  }

  .about-content :global(.role-dates) {
    display: block;
    font-size: 0.85rem;
    color: var(--text-dim);
    font-weight: 400;
    font-family: var(--font-ui);
    line-height: 1.45;
    margin-top: 0.55rem;
  }

  .about-content :global(p) {
    color: var(--text-body);
    font-size: 1.06rem;
    line-height: 1.75;
    margin-bottom: 1.25rem;
  }

  .about-content :global(ul) {
    margin-left: 1.25rem;
    margin-bottom: 0.85rem;
  }

  .about-content :global(li) {
    color: var(--text-body);
    font-size: 1.04rem;
    margin-bottom: 0.6rem;
    line-height: 1.7;
  }

  .about-content :global(strong) {
    color: var(--text-heading);
  }

  .contact-links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  @media (max-width: 640px) {
    .about-header {
      padding-top: 3rem;
    }
  }
</style>
