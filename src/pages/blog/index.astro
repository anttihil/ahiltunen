---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Writing | Antti Hiltunen"
  description="Essays by Antti Hiltunen on software systems, engineering, and philosophy."
>
  <div class="writing-page">
    <header class="page-header">
      <p class="overline">An index of essays</p>
      <h1>Writing</h1>
      <p>Things I’ve learned while building software, and questions I’m still working through.</p>
    </header>
    <div class="post-list">
      {posts.map((post, index) => (
        <article class="post-item">
          <span class="entry-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })}
            </time>
          </div>
        </article>
      ))}
    </div>
    <a class="rss-link" href="/rss.xml">Follow by RSS →</a>
  </div>
</BaseLayout>

<style>
  .writing-page {
    padding: 5rem 0 7rem;
  }

  .page-header {
    max-width: 650px;
    margin-bottom: 3.5rem;
  }

  .page-header .overline {
    margin-bottom: 1.25rem;
    color: var(--text-accent);
    font-size: 0.85rem;
    font-style: italic;
    letter-spacing: 0.04em;
  }

  .page-header h1 {
    margin-bottom: 0.8rem;
    font-size: clamp(3.2rem, 6vw, 4.5rem);
    letter-spacing: -0.045em;
  }

  .page-header p {
    margin: 0;
    color: var(--text-muted);
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .post-item {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1.2rem;
    padding: 1.45rem 0;
    border-bottom: 1px solid var(--border-light);
  }

  .post-item:first-child {
    border-top: 1px solid var(--border-color);
  }

  .entry-number {
    padding-top: 0.14rem;
    color: var(--text-accent);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-style: italic;
  }

  .post-item h2 {
    max-width: 630px;
    margin-bottom: 0.25rem;
    font-size: clamp(1.4rem, 2.4vw, 1.7rem);
    line-height: 1.25;
  }

  .post-item a {
    text-decoration: none;
  }

  .post-item a:hover {
    text-decoration: underline;
  }

  .post-item time {
    color: var(--text-dim);
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-style: italic;
  }

  .rss-link {
    display: inline-block;
    margin-top: 2rem;
    color: var(--text-accent);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    text-decoration: none;
  }

  .rss-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .writing-page {
      padding-top: 3.5rem;
    }
  }
</style>
