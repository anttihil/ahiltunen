---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const recentPosts = sortedPosts.slice(0, 3);

const projects = [
  {
    title: "AI-Powered Platform Migration & Coding Agents",
    subtitle: "Software Engineer @ UCLA (Jan 2025 – Present)",
    description: "Replaced 20 legacy sites end-to-end. Leveraged LLM coding agents to mine millions of lines of site data into deterministic XML transformation rules, cutting ~1,000 hours of manual work. Consolidated infrastructure into a multi-tenant platform with centralized CI/CD and IaC.",
    role: "Lead Engineer"
  },
  {
    title: "On-Premise Faculty AI & WCAG Platform",
    subtitle: "Software Engineer @ UCLA (Jan 2025 – Present)",
    description: "Architected full-stack on-premise system for sensitive faculty data. Built self-service WCAG compliance tooling targeting ~60,000 public PDFs. Tuned self-hosted LLMs with vLLM to serve concurrent classroom analysis on a single constrained GPU.",
    role: "Sole Architect"
  },
  {
    title: "Brain Corp Commercial Robotics UI & Protocol Simulator",
    subtitle: "Software Engineer @ Brain Corp / ISBX (May 2022 – Dec 2024)",
    description: "Sole UI developer for two commercial robot models across ~20 releases. Embedded a protocol-level robot simulator in frontend to cut dev cycles from days to minutes. Delivered flagship A-to-B cleaning UI using DeckGL over clustered points of interest.",
    role: "Sole UI Developer"
  }
];
---

<BaseLayout>
  <!-- Hero Section -->
  <section class="hero-section container">
    <h1 class="hero-title">
      Antti Hiltunen
    </h1>

    <p class="hero-description">
      Software engineer building internal platforms, infrastructure (Terraform, Ansible, Docker), AI systems (vLLM, Ollama), and hardware/web user interfaces. Software Engineer at UCLA, formerly primary UI developer for Brain Corp robotics models. UCLA  in Philosophy.
    </p>

    <div class="hero-links">
      <a href="/projects" class="inline-link">View projects →</a>
      <a href="/resume-antti-shared.pdf" target="_blank" rel="noopener noreferrer" class="inline-link">Resume (PDF) ↗</a>
      <a href="/blog" class="inline-link">Writing →</a>
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="section container">
    <div class="section-header">
      <h2>Featured Projects</h2>
      <a href="/projects" class="section-link">All projects →</a>
    </div>

    <div class="vertical-stream">
      {projects.map((project) => (
        <ProjectCard {...project} />
      ))}
    </div>
  </section>

  <!-- Writing -->
  <section class="section container">
    <div class="section-header">
      <h2>Writing & Essays</h2>
      <a href="/blog" class="section-link">All articles →</a>
    </div>

    <div class="vertical-stream">
      {recentPosts.map((post) => (
        <BlogCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          slug={post.id}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    margin-bottom: 3.5rem;
  }

  .hero-title {
    margin-bottom: 1rem;
    font-size: 2.2rem;
  }

  .hero-description {
    font-size: 1.08rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .hero-links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .section {
    margin-bottom: 3.5rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .section-header h2 {
    font-size: 1.3rem;
    color: var(--text-heading);
  }

  .section-link {
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .section-link:hover {
    color: var(--accent-link);
  }
</style>
