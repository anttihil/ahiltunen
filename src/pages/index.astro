---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const recentPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<BaseLayout>
  <div class="home-page">
    <header class="introduction">
      <p class="overline">Notes on software, systems & philosophy</p>
      <h1>Antti Hiltunen</h1>
      <p>
        I’m a software engineer with a background in philosophy. I write about the systems I work on, the choices behind them, and ideas that help me think more clearly.
      </p>
    </header>

    <section class="writing-section" aria-labelledby="recent-writing-title">
      <div class="section-heading">
        <h2 id="recent-writing-title">Recent writing</h2>
      </div>
      <div class="essay-list">
        {recentPosts.map((post, index) => (
          <article class="essay-item">
            <span class="entry-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })}
              </time>
            </div>
          </article>
        ))}
      </div>
      <a href="/blog" class="all-writing">Browse all writing →</a>
    </section>

    <section class="elsewhere" aria-labelledby="elsewhere-title">
      <h2 id="elsewhere-title">Elsewhere</h2>
      <p>
        I work on software at UCLA. Before that, I built interfaces for autonomous robots and taught logic. <a href="/about">A little more about me</a> and <a href="/projects">selected work</a> are here if you’re curious.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .home-page {
    padding: 5rem 0 6rem;
  }

  .introduction {
    max-width: 660px;
    margin-bottom: 4.25rem;
  }

  .overline {
    margin-bottom: 1.25rem;
    color: var(--text-accent);
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-style: italic;
    letter-spacing: 0.04em;
  }

  .introduction h1 {
    margin-bottom: 1.1rem;
    font-size: clamp(3.2rem, 6vw, 4.5rem);
    letter-spacing: -0.045em;
  }

  .introduction p {
    margin: 0;
    color: var(--text-muted);
    font-size: clamp(1.15rem, 2vw, 1.3rem);
    line-height: 1.7;
  }

  .introduction::after {
    content: '';
    display: block;
    width: 2.25rem;
    height: 2px;
    margin-top: 2.5rem;
    background: var(--accent-blush);
  }

  .section-heading {
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--border-color);
  }

  .section-heading h2,
  .elsewhere h2 {
    color: var(--text-accent);
    font-family: var(--font-display);
    font-size: 1rem;
    font-variant: small-caps;
    letter-spacing: 0.08em;
  }

  .essay-item {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1.2rem;
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--border-light);
  }

  .entry-number {
    padding-top: 0.13rem;
    color: var(--text-accent);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-style: italic;
  }

  .essay-item h3 {
    max-width: 620px;
    margin-bottom: 0.25rem;
    font-size: clamp(1.35rem, 2.4vw, 1.7rem);
    line-height: 1.25;
  }

  .essay-item a {
    text-decoration: none;
  }

  .essay-item a:hover {
    text-decoration: underline;
  }

  .essay-item time {
    color: var(--text-dim);
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-style: italic;
  }

  .all-writing {
    display: inline-block;
    margin-top: 1.25rem;
    color: var(--text-accent);
    font-family: var(--font-ui);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .all-writing:hover {
    text-decoration: underline;
  }

  .elsewhere {
    max-width: 640px;
    margin-top: 5.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-color);
  }

  .elsewhere h2 {
    margin-bottom: 0.8rem;
  }

  .elsewhere p {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  @media (max-width: 640px) {
    .home-page {
      padding: 3.5rem 0 5rem;
    }

    .introduction {
      margin-bottom: 3.5rem;
    }

    .elsewhere {
      margin-top: 4rem;
    }
  }
</style>
