---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const recentPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<BaseLayout>
  <div class="home-page">
    <header class="introduction">
      <h1>Antti Hiltunen</h1>
      <p>
        I’m a software engineer with a background in philosophy. I write about the systems I work on, the choices behind them, and ideas that help me think more clearly.
      </p>
    </header>

    <section class="writing-section" aria-labelledby="recent-writing-title">
      <div class="section-heading">
        <h2 id="recent-writing-title">Recent writing</h2>
        <a href="/blog">All essays →</a>
      </div>
      <div class="essay-list">
        {recentPosts.map((post) => (
          <article class="essay-item">
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })}
            </time>
            <h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
          </article>
        ))}
      </div>
    </section>

    <section class="elsewhere" aria-labelledby="elsewhere-title">
      <h2 id="elsewhere-title">Elsewhere</h2>
      <p>
        I work on software at UCLA. Before that, I built interfaces for autonomous robots and taught logic. <a href="/about">A little more about me</a> and <a href="/projects">selected work</a> are here if you’re curious.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .home-page {
    padding: 5.5rem 0 7rem;
  }

  .introduction {
    max-width: 660px;
    margin-bottom: 5rem;
  }

  .introduction h1 {
    margin-bottom: 1rem;
    font-size: clamp(2.55rem, 5vw, 3.4rem);
    letter-spacing: -0.035em;
  }

  .introduction p {
    margin: 0;
    color: var(--text-muted);
    font-size: clamp(1.12rem, 2vw, 1.27rem);
    line-height: 1.7;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--border-color);
  }

  .section-heading h2,
  .elsewhere h2 {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.025em;
  }

  .section-heading a {
    flex-shrink: 0;
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  .section-heading a:hover {
    text-decoration: underline;
  }

  .essay-item {
    display: grid;
    grid-template-columns: 100px minmax(0, 1fr);
    gap: 1rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border-light);
  }

  .essay-item time {
    padding-top: 0.2rem;
    color: var(--text-dim);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .essay-item h3 {
    max-width: 620px;
    font-size: clamp(1.25rem, 2.4vw, 1.5rem);
    line-height: 1.3;
  }

  .essay-item a {
    text-decoration: none;
  }

  .essay-item a:hover {
    text-decoration: underline;
  }

  .elsewhere {
    max-width: 640px;
    margin-top: 5rem;
  }

  .elsewhere h2 {
    margin-bottom: 0.8rem;
  }

  .elsewhere p {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  @media (max-width: 640px) {
    .home-page {
      padding: 3.75rem 0 5rem;
    }

    .introduction {
      margin-bottom: 4rem;
    }

    .essay-item {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }

    .elsewhere {
      margin-top: 4rem;
    }
  }
</style>
