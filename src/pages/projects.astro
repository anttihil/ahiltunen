---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const featuredProjects = [
  {
    id: "site-platform",
    title: "AI Coding Agent Migration & Multi-Tenant Platform",
    subtitle: "Lead Engineer • Software Engineer @ UCLA (Jan 2025 – Present)",
    description: "Designed and delivered the replacement end-to-end for 20 legacy sites. Cut ~1,000 hours of manual migration by prompting AI coding agents to mine millions of lines of site data into deterministic XML transformation rules. Consolidated 20 independently maintained sites into a multi-tenant platform with centralized CI/CD and IaC (Terraform, Ansible). Developed a content inventory tool surfacing media volume, page age, and WCAG accessibility issues."
  },
  {
    id: "private-ai",
    title: "On-Premise Faculty AI Systems & WCAG Remediation",
    subtitle: "Sole Architect • Software Engineer @ UCLA (Jan 2025 – Present)",
    description: "Architected an on-premise platform for faculty data that cannot leave university hardware. Built the full stack alone—from GPU provisioning and job scheduling to multi-tenant auth, admin UI, and application flows. Shipped a self-service WCAG compliance system targeting an ADA exposure of ~60,000 public PDFs (adopted by a 5-person remediation team). Piloted self-hosted LLMs tuned with vLLM to serve concurrent classroom analysis on a single constrained GPU."
  },
  {
    id: "robotics-ui",
    title: "Brain Corp Commercial Robotics UI & Protocol Simulator",
    subtitle: "Sole UI Developer • Software Engineer @ Brain Corp / ISBX (May 2022 – Dec 2024)",
    description: "Sole UI developer for two commercial robot models across ~20 releases. Reduced dev cycles from days to minutes and enabled portable sales demos by embedding a protocol-level robot simulator in the frontend, eliminating all hardware and backend dependencies. Delivered UI for flagship on-demand A-to-B cleaning using DeckGL for map zone selection over clustered points of interest. Cut QA field troubleshooting time by 50% with an embedded observability dashboard and internationalized the UI to 15 countries."
  }
];
---

<BaseLayout
  title="Projects | Antti Hiltunen"
  description="Software engineering projects by Antti Hiltunen covering internal platforms, AI systems orchestration, legacy migration tooling, and commercial robotics UIs."
>
  <div class="projects-container">
    <header class="projects-header">
      <h1 class="projects-title">Work</h1>
      <p class="projects-lead">
        Platform engineering, on-premise AI systems, legacy automation tooling, and commercial robotics interfaces.
      </p>
    </header>

    <div class="projects-list-section">
      <div class="projects-list">
        {featuredProjects.map((project) => (
          <ProjectCard {...project} />
        ))}
      </div>
    </div>

  </div>
</BaseLayout>

<style>
  .projects-container {
    display: flex;
    flex-direction: column;
  }

  .projects-header {
    padding: 4.5rem 0 2.5rem;
  }

  .projects-title {
    margin-bottom: 0.5rem;
    font-size: clamp(2.55rem, 5vw, 3.4rem);
  }

  .projects-lead {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0;
  }

  .projects-list-section {
    padding: 0 0 6rem;
  }

  .projects-list {
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 640px) {
    .projects-header {
      padding-top: 3rem;
    }
  }
</style>
