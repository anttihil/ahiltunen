---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <p>Antti Hiltunen · {currentYear}</p>
  <nav aria-label="Follow and contact">
    <a href="/rss.xml">RSS</a>
    <a href="mailto:anttihil@gmail.com">Email</a>
  </nav>
</footer>

<style>
  .footer {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    margin-top: auto;
    padding: 1.75rem 0 2.5rem;
    border-top: 1px solid var(--border-color);
    color: var(--text-dim);
    font-family: var(--font-ui);
    font-size: 0.78rem;
  }

  .footer p {
    margin: 0;
  }

  .footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .footer a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .footer a:hover {
    color: var(--text-heading);
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .footer {
      flex-direction: column;
      gap: 0.75rem;
    }
  }
</style>
