---
const currentYear = new Date().getFullYear();
---

<footer class="framed-box footer">
  <div class="footer-content">
    <div class="footer-left">
      <p class="footer-name">Antti Hiltunen</p>
      <p class="footer-bio">
        Software Engineer at UCLA building internal platforms, AI systems, and hardware interfaces.
      </p>
    </div>

    <div class="footer-right">
      <a href="/about">About</a>
      <a href="/blog">Blog</a>
      <a href="/projects">Projects</a>
      <a href="/resume-antti-shared.pdf" target="_blank" rel="noopener noreferrer">Resume (PDF)</a>
      <a href="https://www.linkedin.com/in/hiltunen-antti" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
      <a href="https://github.com/anttihil" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      <a href="mailto:anttihil@gmail.com">Email</a>
    </div>
  </div>

  <div class="footer-bottom">
    <p>© {currentYear} Antti Hiltunen. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    padding: 1.5rem;
    margin-top: auto;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-light);
  }

  .footer-left {
    max-width: 450px;
  }

  .footer-name {
    font-weight: 600;
    color: var(--text-heading);
    margin-bottom: 0.25rem;
    font-size: 0.98rem;
  }

  .footer-bio {
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.55;
    margin: 0;
  }

  .footer-right {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    align-items: center;
  }

  .footer-right a {
    color: var(--text-muted);
    font-size: 0.88rem;
    text-decoration: none;
  }

  .footer-right a:hover {
    color: var(--text-heading);
    text-decoration: underline;
  }

  .footer-bottom {
    padding-top: 1rem;
    font-size: 0.8rem;
    color: var(--text-dim);
    font-family: var(--font-code);
  }

  @media (max-width: 640px) {
    .footer-content {
      flex-direction: column;
      gap: 1.25rem;
    }

    .footer-right {
      gap: 0.85rem;
    }
  }
</style>
