---
interface Props {
  id: string;
  title: string;
  subtitle?: string;
  links: { label: string; url: string }[];
}

const { id, title, subtitle, links } = Astro.props;
---

<article id={id} class="work-entry">
  <div class="work-entry-header">
    <h3 class="work-entry-title">{title}</h3>
    {subtitle && <p class="work-entry-meta">{subtitle}</p>}
  </div>

  <div class="work-entry-description"><slot /></div>

  {links.length > 0 && (
    <div class="work-entry-links">
      {links.map((link) => (
        <a href={link.url} class="inline-link" target={link.url.startsWith('http') ? '_blank' : undefined} rel={link.url.startsWith('http') ? 'noopener noreferrer' : undefined}>
          {link.label}{link.url.startsWith('http') ? ' ↗' : ' →'}
        </a>
      ))}
    </div>
  )}
</article>

<style>
  .work-entry {
    padding: 2rem 0;
    border-top: 1px solid var(--border-color);
  }

  .work-entry-header {
    margin-bottom: 0.5rem;
  }

  .work-entry-title {
    font-size: 1.45rem;
    font-weight: 400;
    color: var(--text-heading);
    margin-bottom: 0.25rem;
    line-height: 1.35;
  }

  .work-entry-meta {
    margin-bottom: 0;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .work-entry-description {
    color: var(--text-body);
    font-size: 1.05rem;
    line-height: 1.72;
  }

  .work-entry-description :global(p:last-child) {
    margin-bottom: 0;
  }

  .work-entry-links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
  }
</style>
