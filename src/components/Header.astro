---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.endsWith('/') && pathname.length > 1 ? pathname.slice(0, -1) : pathname;

const navItems = [
  { name: 'Writing', path: '/blog' },
  { name: 'About', path: '/about' },
  { name: 'Work', path: '/work' },
];
---

<header class="header">
  <a href="/" class="logo" aria-label="Antti Hiltunen, home">Antti Hiltunen</a>
  <nav class="nav" aria-label="Main navigation">
    {navItems.map((item) => {
      const isActive = currentPath === item.path || currentPath.startsWith(`${item.path}/`);
      return <a href={item.path} class:list={['nav-link', { active: isActive }]} aria-current={isActive ? 'page' : undefined}>{item.name}</a>;
    })}
  </nav>
</header>

<style>
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 1.7rem 0;
    border-bottom: 1px solid var(--border-color);
  }

  .logo {
    color: var(--text-heading);
    font-family: var(--font-reading);
    font-size: 1.2rem;
    font-weight: 400;
    letter-spacing: -0.015em;
    text-decoration: none;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
  }

  .nav-link {
    color: var(--text-accent);
    font-family: var(--font-ui);
    font-size: 0.83rem;
    text-decoration: none;
  }

  .nav-link.active {
    color: var(--text-heading);
    text-decoration: underline;
    text-underline-offset: 0.4em;
  }

  .nav-link:hover {
    color: var(--accent-hover);
    text-decoration: underline;
    text-underline-offset: 0.4em;
  }

  @media (max-width: 520px) {
    .header {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.75rem;
      padding: 1.25rem 0;
    }
  }
</style>
