---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.endsWith('/') && pathname.length > 1 ? pathname.slice(0, -1) : pathname;

const navItems = [
  { name: 'About', path: '/about' },
  { name: 'Blog', path: '/blog' },
  { name: 'Projects', path: '/projects' },
];
---

<header class="framed-box header">
  <div class="header-content">
    <a href="/" class="logo">
      Antti Hiltunen
    </a>

    <nav class="nav">
      {navItems.map((item) => {
        const isActive = currentPath === item.path || (item.path !== '/' && currentPath.startsWith(item.path));
        return (
          <a
            href={item.path}
            class:list={['nav-link', { active: isActive }]}
          >
            {item.name}
          </a>
        );
      })}
      <a href="/resume-antti-shared.pdf" target="_blank" rel="noopener noreferrer" class="nav-link resume-link">
        Resume (PDF)
      </a>
    </nav>
  </div>
</header>

<style>
  .header {
    padding: 1.1rem 1.5rem;
  }

  .header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .logo {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-heading);
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .logo:hover {
    text-decoration: underline;
    opacity: 0.8;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-link {
    color: var(--text-body);
    font-size: 0.95rem;
    text-decoration: none;
    font-weight: 500;
    transition: opacity var(--transition-fast);
  }

  .nav-link:hover {
    text-decoration: underline;
    opacity: 0.7;
  }

  .nav-link.active {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .resume-link {
    color: var(--text-muted);
    font-size: 0.88rem;
  }

  @media (max-width: 640px) {
    .header {
      padding: 1rem 1rem;
    }

    .header-content {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
    }

    .nav {
      flex-wrap: wrap;
      gap: 1rem;
      width: 100%;
    }
  }
</style>
