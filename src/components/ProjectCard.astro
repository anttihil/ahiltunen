---
interface Props {
  id?: string;
  title: string;
  subtitle: string;
  description: string;
  role?: string;
  link?: string;
  github?: string;
}

const { id, title, subtitle, description, role, link, github } = Astro.props;
---

<article id={id} class="project-entry">
  <div class="project-header">
    <h2 class="project-title">{title}</h2>
    <div class="project-meta">
      <span class="project-subtitle">{subtitle}</span>
      {role && <span class="project-role">• {role}</span>}
    </div>
  </div>

  <p class="project-description">{description}</p>

  {(link || github) && (
    <div class="project-links">
      {link && (
        <a href={link} class="inline-link">
          Read more →
        </a>
      )}
      {github && (
        <a href={github} class="inline-link" target="_blank" rel="noopener noreferrer">
          Source code ↗
        </a>
      )}
    </div>
  )}
</article>

<style>
  .project-entry {
    padding: 2rem 0;
    border-top: 1px solid var(--border-color);
  }

  .project-entry:first-child {
    padding-top: 2rem;
  }

  .project-header {
    margin-bottom: 0.5rem;
  }

  .project-title {
    font-size: 1.45rem;
    font-weight: 400;
    color: var(--text-heading);
    margin-bottom: 0.25rem;
    line-height: 1.35;
  }

  .project-meta {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    color: var(--text-dim);
  }

  .project-subtitle {
    color: var(--text-muted);
  }

  .project-role {
    color: var(--text-dim);
    margin-left: 0.25rem;
  }

  .project-description {
    color: var(--text-body);
    font-size: 1.05rem;
    line-height: 1.72;
    margin-bottom: 0.75rem;
  }

  .project-links {
    display: flex;
    gap: 1.25rem;
    margin-top: 0.5rem;
  }
</style>
